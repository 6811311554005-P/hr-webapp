// Prisma schema — HR Management System
// Production-level HR database schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

/// Employee employment status
enum EmployeeStatus {
  ACTIVE
  RESIGNED
  ON_LEAVE
  RETIRED
}

// ─── User Model (Admin Only) ────────────────────────────────────────────────
/// Administrative users for system access
/// NOT related to Employee records
model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  role         String @default("admin")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]
  importFiles ImportFile[]

  @@index([email])
}

enum AuditAction {
  AUTH_LOGIN
  AUTH_FAILED
  USER_LOGOUT
  READ
  CREATE
  UPDATE
  DELETE
  IMPORT
  HEALTH_CHECK
  ERROR
}

enum ImportFileStatus {
  QUARANTINED
  REJECTED
  IMPORTED
  EXPIRED
  DELETED
}

model AuditLog {
  id         Int         @id @default(autoincrement())
  action     AuditAction
  entity     String
  entityId   String?
  method     String
  path       String
  statusCode Int
  userId     Int?
  userEmail  String?
  ipAddress  String?
  userAgent  String?     @db.Text
  metadata   Json?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entity, createdAt])
}

model ImportFile {
  id           Int              @id @default(autoincrement())
  sha256       String           @unique
  originalName String
  storedName   String
  storagePath  String           @db.Text
  mimeType     String
  extension    String
  sizeBytes    BigInt
  status       ImportFileStatus @default(QUARANTINED)
  refCount     Int              @default(1)
  uploadedById Int?
  uploadedBy   User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  importedCount Int             @default(0)
  rejectedReason String?        @db.Text
  metadata      Json?
  expiresAt     DateTime?
  lastUsedAt    DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([sha256])
  @@index([status])
  @@index([uploadedById])
  @@index([expiresAt])
  @@index([createdAt])
}

// ─── Department Model ───────────────────────────────────────────────────────
/// Organizational departments
model Department {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String  @unique
  description String? @db.Text

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  employees Employee[]
  positions Position[]

  @@index([code])
  @@index([isActive])
}

// ─── Position Model ─────────────────────────────────────────────────────────
/// Job positions/titles
model Position {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String  @unique
  level       String  @default("Entry")
  description String? @db.Text

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  employees Employee[]

  @@index([code])
  @@index([departmentId])
  @@index([isActive])
}

// ─── Employee Model ─────────────────────────────────────────────────────────
/// Employee records with Thai-specific fields
model Employee {
  id Int @id @default(autoincrement())

  // Identification
  employeeCode String @unique
  firstName    String
  lastName     String?

  // Thai-specific contract fields
  contractNumber String? @unique /// ใบสั่งจ้างเลขที่
  positionNumber String? @unique /// ตำแหน่งเลขที่

  // Personal information
  birthDate DateTime?
  hireDate  DateTime? /// Employment start date

  // Employment status
  status EmployeeStatus @default(ACTIVE)
  resignationDate DateTime? /// วันที่ลาออก
  resignationReason String? @db.Text /// หมายเหตุการลาออก

  // Compensation
  salary Decimal @default(0) @db.Decimal(12, 2)

  // Relations
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  positionId Int?
  position   Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  resignationHistories ResignationHistory[]

  // Metadata
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeCode])
  @@index([departmentId])
  @@index([positionId])
  @@index([status])
  @@index([hireDate])
  @@index([createdAt])
}

// ─── ResignationHistory Model ───────────────────────────────────────────────
model ResignationHistory {
  id              Int      @id @default(autoincrement())
  employeeId      Int
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  resignationDate DateTime
  reason          String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([employeeId])
}
